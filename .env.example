# Copy to .env.local and fill in your values.
# Get a free odds key (500 credits/month) at https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# Neon Serverless Postgres connection string. The Vercel-managed Neon integration
# injects DATABASE_URL automatically when you attach a Neon store to the project.
# For local dev, copy your Neon connection string here. POSTGRES_URL also works.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
